requires "semantics.k"
module PROGRAM-HELPER
 imports KPYC-SEMANTICS
 syntax Map ::= targetRunCode() [function, total]
 rule targetRunCode() =>
   (0 |-> RESUME(0))
   (1 |-> LOAD_SMALL_INT(0))
   (2 |-> STORE_FAST(4))
   (3 |-> LOAD_FAST(0))
   (4 |-> STORE_FAST(2))
   (5 |-> LOAD_SMALL_INT(0))
   (6 |-> LOAD_FAST_BORROW(2))
   (7 |-> COMPARE_OP(18))
   (8 |-> CACHE(0))
   (9 |-> POP_JUMP_IF_FALSE(49))
   (10 |-> CACHE(0))
   (11 |-> NOT_TAKEN(0))
   (12 |-> LOAD_FAST_BORROW_LOAD_FAST_BORROW(33))
   (13 |-> COMPARE_OP(58))
   (14 |-> CACHE(0))
   (15 |-> POP_JUMP_IF_FALSE(31))
   (16 |-> CACHE(0))
   (17 |-> NOT_TAKEN(0))
   (18 |-> LOAD_FAST(2))
   (19 |-> STORE_FAST(3))
   (20 |-> LOAD_SMALL_INT(0))
   (21 |-> LOAD_FAST_BORROW(3))
   (22 |-> COMPARE_OP(18))
   (23 |-> CACHE(0))
   (24 |-> POP_JUMP_IF_FALSE(21))
   (25 |-> CACHE(0))
   (26 |-> NOT_TAKEN(0))
   (27 |-> LOAD_FAST_BORROW(4))
   (28 |-> LOAD_SMALL_INT(1))
   (29 |-> BINARY_OP(0))
   (30 |-> CACHE(0))
   (31 |-> CACHE(0))
   (32 |-> CACHE(0))
   (33 |-> CACHE(0))
   (34 |-> CACHE(0))
   (35 |-> STORE_FAST(4))
   (36 |-> LOAD_FAST_BORROW(3))
   (37 |-> LOAD_SMALL_INT(1))
   (38 |-> BINARY_OP(10))
   (39 |-> CACHE(0))
   (40 |-> CACHE(0))
   (41 |-> CACHE(0))
   (42 |-> CACHE(0))
   (43 |-> CACHE(0))
   (44 |-> STORE_FAST(3))
   (45 |-> JUMP_BACKWARD(27))
   (46 |-> CACHE(0))
   (47 |-> JUMP_FORWARD(1))
   (48 |-> NOP(0))
   (49 |-> LOAD_FAST_BORROW(2))
   (50 |-> LOAD_SMALL_INT(1))
   (51 |-> BINARY_OP(10))
   (52 |-> CACHE(0))
   (53 |-> CACHE(0))
   (54 |-> CACHE(0))
   (55 |-> CACHE(0))
   (56 |-> CACHE(0))
   (57 |-> STORE_FAST(2))
   (58 |-> JUMP_BACKWARD(55))
   (59 |-> CACHE(0))
   (60 |-> LOAD_FAST_BORROW_LOAD_FAST_BORROW(1))
   (61 |-> LOAD_FAST_BORROW_LOAD_FAST_BORROW(35))
   (62 |-> LOAD_FAST_BORROW(4))
   (63 |-> BUILD_TUPLE(5))
   (64 |-> RETURN_VALUE(0))
endmodule
