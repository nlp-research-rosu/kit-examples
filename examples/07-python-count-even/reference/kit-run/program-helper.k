requires "semantics.k"
module PROGRAM-HELPER
 imports KPYC-SEMANTICS
 syntax Map ::= targetRunCode() [function, total]
 rule targetRunCode() =>
   (0 |-> RESUME(0))
   (1 |-> LOAD_SMALL_INT(0))
   (2 |-> STORE_FAST(2))
   (3 |-> LOAD_SMALL_INT(0))
   (4 |-> STORE_FAST(1))
   (5 |-> LOAD_FAST_BORROW_LOAD_FAST_BORROW(16))
   (6 |-> COMPARE_OP(18))
   (7 |-> CACHE(0))
   (8 |-> POP_JUMP_IF_FALSE(37))
   (9 |-> CACHE(0))
   (10 |-> NOT_TAKEN(0))
   (11 |-> LOAD_FAST_BORROW(1))
   (12 |-> LOAD_SMALL_INT(2))
   (13 |-> BINARY_OP(6))
   (14 |-> CACHE(0))
   (15 |-> CACHE(0))
   (16 |-> CACHE(0))
   (17 |-> CACHE(0))
   (18 |-> CACHE(0))
   (19 |-> LOAD_SMALL_INT(0))
   (20 |-> COMPARE_OP(88))
   (21 |-> CACHE(0))
   (22 |-> POP_JUMP_IF_FALSE(11))
   (23 |-> CACHE(0))
   (24 |-> NOT_TAKEN(0))
   (25 |-> LOAD_FAST_BORROW(2))
   (26 |-> LOAD_SMALL_INT(1))
   (27 |-> BINARY_OP(0))
   (28 |-> CACHE(0))
   (29 |-> CACHE(0))
   (30 |-> CACHE(0))
   (31 |-> CACHE(0))
   (32 |-> CACHE(0))
   (33 |-> STORE_FAST(2))
   (34 |-> JUMP_FORWARD(1))
   (35 |-> NOP(0))
   (36 |-> LOAD_FAST_BORROW(1))
   (37 |-> LOAD_SMALL_INT(1))
   (38 |-> BINARY_OP(0))
   (39 |-> CACHE(0))
   (40 |-> CACHE(0))
   (41 |-> CACHE(0))
   (42 |-> CACHE(0))
   (43 |-> CACHE(0))
   (44 |-> STORE_FAST(1))
   (45 |-> JUMP_BACKWARD(42))
   (46 |-> CACHE(0))
   (47 |-> LOAD_FAST_BORROW_LOAD_FAST_BORROW(1))
   (48 |-> LOAD_FAST_BORROW(2))
   (49 |-> BUILD_TUPLE(3))
   (50 |-> RETURN_VALUE(0))
endmodule
