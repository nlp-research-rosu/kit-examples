   (62 |-> LOAD_FAST_BORROW_LOAD_FAST_BORROW(35))
   (63 |-> LOAD_FAST_BORROW_LOAD_FAST_BORROW(69))
   (64 |-> LOAD_FAST_BORROW_LOAD_FAST_BORROW(103))
