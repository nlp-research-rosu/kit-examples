requires "semantics.k"
module PROGRAM-HELPER
 imports KPYC-SEMANTICS
 syntax Map ::= targetRunCode() [function, total]
 rule targetRunCode() =>
   (0 |-> RESUME(0))
   (1 |-> LOAD_SMALL_INT(0))
   (2 |-> STORE_FAST(3))
   (3 |-> LOAD_FAST(0))
   (4 |-> STORE_FAST(1))
   (5 |-> LOAD_SMALL_INT(0))
   (6 |-> LOAD_FAST_BORROW(1))
   (7 |-> COMPARE_OP(18))
   (8 |-> CACHE(0))
   (9 |-> POP_JUMP_IF_FALSE(41))
   (10 |-> CACHE(0))
   (11 |-> NOT_TAKEN(0))
   (12 |-> LOAD_FAST(1))
   (13 |-> STORE_FAST(2))
   (14 |-> LOAD_SMALL_INT(0))
   (15 |-> LOAD_FAST_BORROW(2))
   (16 |-> COMPARE_OP(18))
   (17 |-> CACHE(0))
   (18 |-> POP_JUMP_IF_FALSE(21))
   (19 |-> CACHE(0))
   (20 |-> NOT_TAKEN(0))
   (21 |-> LOAD_FAST_BORROW(3))
   (22 |-> LOAD_SMALL_INT(1))
   (23 |-> BINARY_OP(0))
   (24 |-> CACHE(0))
   (25 |-> CACHE(0))
   (26 |-> CACHE(0))
   (27 |-> CACHE(0))
   (28 |-> CACHE(0))
   (29 |-> STORE_FAST(3))
   (30 |-> LOAD_FAST_BORROW(2))
   (31 |-> LOAD_SMALL_INT(1))
   (32 |-> BINARY_OP(10))
   (33 |-> CACHE(0))
   (34 |-> CACHE(0))
   (35 |-> CACHE(0))
   (36 |-> CACHE(0))
   (37 |-> CACHE(0))
   (38 |-> STORE_FAST(2))
   (39 |-> JUMP_BACKWARD(27))
   (40 |-> CACHE(0))
   (41 |-> LOAD_FAST_BORROW(1))
   (42 |-> LOAD_SMALL_INT(1))
   (43 |-> BINARY_OP(10))
   (44 |-> CACHE(0))
   (45 |-> CACHE(0))
   (46 |-> CACHE(0))
   (47 |-> CACHE(0))
   (48 |-> CACHE(0))
   (49 |-> STORE_FAST(1))
   (50 |-> JUMP_BACKWARD(47))
   (51 |-> CACHE(0))
   (52 |-> LOAD_FAST_BORROW_LOAD_FAST_BORROW(1))
   (53 |-> LOAD_FAST_BORROW_LOAD_FAST_BORROW(35))
   (54 |-> BUILD_TUPLE(4))
   (55 |-> RETURN_VALUE(0))
endmodule
